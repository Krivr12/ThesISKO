# ========================================
# ThesISKO Server Configuration Template
# ========================================
# Copy this file to config.env and fill in your actual values
# NEVER commit config.env with real credentials!

# Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Configuration (Atlas)
ATLAS_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# PostgreSQL Configuration (Supabase)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Session Configuration
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
THESISKO_DOCUMENTS_BUCKET=your-documents-bucket-name
THESISKO_REPOSITORY_BUCKET=your-repository-bucket-name

# Frontend Configuration
FRONTEND_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5050

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5050/auth/google/callback

# Email Configuration (Resend - Recommended)
RESEND_API_KEY=re_your_resend_api_key
RESEND_MAIL_FROM=noreply@yourdomain.com

# Alternative Email: Gmail SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password

# Alternative Email: Brevo (Optional)
BREVO_API_KEY=your_brevo_api_key
BREVO_MAIL_FROM=your.email@domain.com

# Application URLs
VERIFICATION_URL=http://localhost:4200/verify
RESET_PASSWORD_URL=http://localhost:4200/reset-password
