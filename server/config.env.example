# ThesISKO Server Configuration Template
# Copy this file to config.env and fill in your actual values

#MongoDB
ATLAS_URI=your_mongodb_connection_string

PORT=5050

# Supabase Database Configuration
DATABASE_URL=your_supabase_connection_string
supabaseUrl=your_supabase_url
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Individual parameters
DB_HOST=your_db_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5050/auth/google/callback

# ============================================
# EMAIL SERVICE CONFIGURATION
# See server/config/EMAIL_SETUP.md for setup guide
# ============================================

# --- Gmail SMTP (Recommended for Development) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your-email@gmail.com

# --- Brevo/Sendinblue (Alternative) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-smtp-user
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM=your-verified-email@domain.com

# --- AWS SES (For Production) ---
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-aws-smtp-username
# SMTP_PASS=your-aws-smtp-password
# MAIL_FROM=verified@yourdomain.com

SESSION_SECRET=your_session_secret
NODE_ENV=development

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-2
THESISKO_DOCUMENTS_BUCKET=your_documents_bucket
THESISKO_REPOSITORY_BUCKET=your_repository_bucket
S3_URL_EXPIRY=3600
SES_SENDER_EMAIL=your-email@domain.com

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

